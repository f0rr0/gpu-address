{
  "name": "gpu-postal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:model": "node -e \"const fs=require('fs'),z=require('zlib');fs.mkdirSync('public',{recursive:true});fs.writeFileSync('public/model-int5.bin.br',z.brotliCompressSync(fs.readFileSync('../../packages/core/model.bin'),{params:{[z.constants.BROTLI_PARAM_QUALITY]:11}}))\"",
    "dev": "npm run build --workspace gpu-postal && npm run prepare:model && next dev",
    "build": "npm run build --workspace gpu-postal && npm run prepare:model && next build",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "gpu-lexer": "^0.0.3",
    "gpu-postal": "0.1.0-experimental.3",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
